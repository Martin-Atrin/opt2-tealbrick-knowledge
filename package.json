{
  "name": "opt2-tealbrick-knowledge",
  "version": "0.1.7",
  "private": true,
  "description": "Teal Brick Knowledge miniapp (opt2): canonical documents and walled memory areas over pinned upstream engines.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node --test 'test/**/*.test.ts'",
    "conformance": "mkdir -p .conformance && chmod 0777 .conformance && tb-conformance app --start conformance.start.ts --manifest tealbrick.manifest.json --report .conformance/report",
    "build": "tsc -p tsconfig.build.json && node scripts/build-ui.ts",
    "gen": "tb-gen all"
  },
  "dependencies": {
    "@opt2-tealbrick/manifest": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/manifest-v0.1.4/opt2-tealbrick-manifest-0.1.4.tgz",
    "@opt2-tealbrick/miniapp-sdk": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/miniapp-sdk-v0.1.6/opt2-tealbrick-miniapp-sdk-0.1.6.tgz",
    "@opt2-tealbrick/spec": "https://github.com/Martin-Atrin/opt2-tealbrick-specs/releases/download/spec-v0.1.7/opt2-tealbrick-spec-0.1.7.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opt2-tealbrick/conformance": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/conformance-v0.1.3/opt2-tealbrick-conformance-0.1.3.tgz",
    "@opt2-tealbrick/ui": "https://github.com/Martin-Atrin/opt2-tealbrick-packages/releases/download/ui-v0.1.1/opt2-tealbrick-ui-0.1.1.tgz",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@9.15.4"
}
